# Copie ce fichier en `.env` et adapte les chemins si besoin.
# Toutes ces variables sont optionnelles : sans elles, paths.py utilise
# les valeurs par defaut relatives a la racine du projet (indiquees ci-dessous).

# Fichier de configuration du modele et de l'entrainement (defaut : <racine>/config.json)
CONFIG_PATH=config.json

# Dossier des artefacts produits : tokenizer, checkpoints (defaut : <racine>/artifacts)
ARTIFACTS_DIRECTORY=artifacts

# Dossier des livres bruts en .txt utilises pour l'entrainement (defaut : <racine>/data/books)
DATA_DIRECTORY=data/books

# Dossier des donnees tokenisees train.bin / val.bin (defaut : <racine>/data/bin)
BIN_DATA_DIRECTORY=data/bin

# Fichier du tokenizer BPE entraine (defaut : <ARTIFACTS_DIRECTORY>/gutenberg-fr-tokenizer.json)
TOKENIZER_PATH=artifacts/gutenberg-fr-tokenizer.json

# Checkpoint du modele (defaut : <ARTIFACTS_DIRECTORY>/gutenberg-gpt.pt)
MODEL_PATH=artifacts/gutenberg-gpt.pt
