# Copy this file to `.env` and adjust the paths if you need to.
# Every variable is optional: without them, paths.py falls back to the
# defaults below, all relative to the project root.

# Model and training configuration file (default: <root>/config.json)
CONFIG_PATH=config.json

# Where produced artifacts land: tokenizer, checkpoints (default: <root>/artifacts)
ARTIFACTS_DIRECTORY=artifacts

# Folder holding the raw .txt books used for training (default: <root>/data/books_clean)
DATA_DIRECTORY=data/books_clean

# Folder holding the tokenized train.bin / val.bin (default: <root>/data/bin)
BIN_DATA_DIRECTORY=data/bin

# Trained BPE tokenizer file (default: <ARTIFACTS_DIRECTORY>/gutenberg-fr-tokenizer.json)
TOKENIZER_PATH=artifacts/gutenberg-fr-tokenizer.json

# Model checkpoint (default: <ARTIFACTS_DIRECTORY>/gutenberg-gpt.pt)
MODEL_PATH=artifacts/gutenberg-gpt.pt
